# ==============================================================================
# CineBook — Global Environment Configuration Template
# ==============================================================================

# Server & Environment Profiles
PORT=8080
SPRING_PROFILES_ACTIVE=local
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=*

# PostgreSQL & pgvector Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cinebook
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/cinebook
DB_USER=postgres
DB_PASSWORD=postgres

# JWT Authentication
JWT_SECRET=cinebook-super-secret-key-minimum-256-bits-long-for-hs256-algorithm

# CineBook AI Microservice Internal Secret
AI_SERVICE_URL=http://localhost:8000
AI_INTERNAL_API_KEY=cinebook-internal-secret-key-change-in-production

# Groq LLM API Key (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-70b-8192

# TMDB (The Movie Database) API Key: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_BASE_URL=https://api.tmdb.org/3

# Razorpay Payment Gateway (Test Mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379

# Vite Frontend API Configuration
VITE_API_BASE_URL=/api
