      "title": "Hybrid & Semantic Retrieval Latency (P95)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(cinebook_ai_retrieval_duration_seconds_bucket[5m])) by (le, mode))",
          "legendFormat": "Retrieval ({{mode}})"
